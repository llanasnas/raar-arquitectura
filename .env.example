# Copia a .env.local (gitignored) y rellena. Nunca commitear valores reales.

# Google Analytics 4 (G-XXXXXXXXXX). Vacío = sin analítica. Solo se carga si el usuario
# acepta las cookies (components/site/Analytics.tsx + lib/consent.ts).
NEXT_PUBLIC_GA_ID=

# URL pública de la web (canonical, sitemap, OG)
NEXT_PUBLIC_SITE_URL=https://www.raar-arquitectura.eu

# Formulario de contacto: sin RESEND_API_KEY, el lead se loguea en consola
RESEND_API_KEY=
CONTACT_TO=
CONTACT_FROM=

# Vídeo del hero (scripts/hero/generate-hero-video.mjs, gasta crédito solo con --confirm)
FAL_KEY=
