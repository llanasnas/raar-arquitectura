# Copia a .env.local (gitignored) y rellena. Nunca commitear valores reales.

# Google Analytics 4 (G-XXXXXXXXXX). Vacío = sin analítica. Solo se carga si el usuario
# acepta las cookies (components/site/Analytics.tsx + lib/consent.ts).
NEXT_PUBLIC_GA_ID=

# URL pública de la web (canonical, sitemap, OG)
NEXT_PUBLIC_SITE_URL=https://www.raar-arquitectura.eu

# Formulario de contacto (lib/mail.ts). Se usa el primero que esté configurado:
#   1. SMTP  2. Resend  3. ninguno → el lead solo se escribe en el log del servidor
# Comprobar credenciales sin tocar la web: node scripts/test-mail.mjs [--send]
#
# SMTP del buzón del estudio. Puertos: 465 = TLS directo, 587 = STARTTLS (por defecto).
# Ejemplos: Gmail/Workspace smtp.gmail.com:465 con contraseña de aplicación;
# IONOS smtp.ionos.es:587; OVH ssl0.ovh.net:465; Microsoft 365 smtp.office365.com:587.
SMTP_HOST=
SMTP_PORT=587
# true/false para forzar TLS directo; vacío = automático según el puerto
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=

# Alternativa a SMTP
RESEND_API_KEY=

# Destino y remitente. CONTACT_FROM debe ser una dirección que el SMTP deje usar
# (normalmente la misma de SMTP_USER). Vacíos: arquitectura@raar-arquitectura.eu / SMTP_USER.
CONTACT_TO=
CONTACT_FROM=

# Vídeo del hero (scripts/hero/generate-hero-video.mjs, gasta crédito solo con --confirm)
FAL_KEY=
